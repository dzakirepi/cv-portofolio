# Salin file ini menjadi .env lalu isi sesuai kebutuhan.
PORT=8080

# Origin frontend saat development (Vite). Untuk produksi tidak perlu,
# karena frontend di-serve langsung oleh backend ini.
FRONTEND_ORIGIN=http://localhost:2303

# Lokasi konten & hasil build React (default sudah sesuai struktur repo)
CONTENT_DIR=./content
STATIC_DIR=../frontend/dist

# Email untuk form kontak. Kosongkan SMTP_HOST jika belum dipakai
# (pesan hanya akan dicatat di log server).
# Contoh Gmail: buat "App Password" di https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=emailkamu@gmail.com
SMTP_PASS=app-password-16-digit
MAIL_FROM=emailkamu@gmail.com
MAIL_TO=emailkamu@gmail.com
