PORT=8080
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Ganti dengan secret acak minimal 32 karakter sebelum deployment.
JWT_SECRET=change-this-secret-to-a-random-string-at-least-32-characters

# Akun admin pertama dibuat otomatis jika belum ada admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Folder ini harus berada pada persistent disk di server production.
STORAGE_DIR=./storage-data
MAX_UPLOAD_MB=5
